# --------------------
# Parameters
# --------------------
SEEDS  = [9, 20, 31, 42, 53, 64, 75, 86, 97, 108, 119, 130, 141, 152, 163]
BETAS  = [0, 1, 4]
CLOCKS = [0.1, 0.5, 1]

HOST_TREE  = "hosts_tree_big.newick"
VIRUS_TREE = "viruses_tree_big.newick"


# --------------------
# Final Target
# --------------------
rule all:
    input:
        expand(
            "results/braga/{seed}/b{beta}_c{clock}/metrics.json",
            seed=SEEDS, beta=BETAS, clock=CLOCKS
        ),
        expand(
            "results/braga/{seed}/b{beta}_c{clock}/elbow_metrics.json",
            seed=SEEDS, beta=BETAS, clock=CLOCKS
        )


# --------------------
# Rule: Simulate viral coevolution using RevBayes
# --------------------
rule braga_simulator:
    output:
        nexus    = "results/braga/{seed}/b{beta}_c{clock}/sim{seed}-b{beta}-c{clock}.nex",
        settings = "results/braga/{seed}/b{beta}_c{clock}/sim{seed}-b{beta}-c{clock}.settings.txt",
        log      = "results/braga/{seed}/b{beta}_c{clock}/simulate.log"
    params:
        outdir = "results/braga/{seed}/b{beta}_c{clock}"
    shell:
        """
        mkdir -p {params.outdir}
        rb Simulate.Rev \
            --args {wildcards.seed} {wildcards.beta} {wildcards.clock} {params.outdir} \
            > {output.log} 2>&1
        """


# --------------------
# Rule: Analyze simulation outputs and compute metrics
# --------------------
rule braga_pipeline:
    input:
        nexus    = "results/braga/{seed}/b{beta}_c{clock}/sim{seed}-b{beta}-c{clock}.nex",
        settings = "results/braga/{seed}/b{beta}_c{clock}/sim{seed}-b{beta}-c{clock}.settings.txt"
    output:
        metrics        = "results/braga/{seed}/b{beta}_c{clock}/metrics.json",
        elbow_metrics  = "results/braga/{seed}/b{beta}_c{clock}/elbow_metrics.json",
        log_out        = "results/braga/{seed}/b{beta}_c{clock}/simulate.out",
        log_err        = "results/braga/{seed}/b{beta}_c{clock}/simulate.err"
    params:
        outdir = "results/braga/{seed}/b{beta}_c{clock}"
    shell:
        """
        python simulation.py \
            --seed {wildcards.seed} \
            --host_tree {HOST_TREE} \
            --virus_tree {VIRUS_TREE} \
            --nexus_file {input.nexus} \
            --braga {input.settings} \
            --outdir {params.outdir} \
            --original_metrics {output.metrics} \
            --elbow_metrics {output.elbow_metrics} \
            > {output.log_out} 2> {output.log_err}
        """


# --------------------
# Rule: Plot results
# --------------------
rule plot_braga_simulation:
    input:
        expand(
            "results/braga/{seed}/b{beta}_c{clock}/metrics.json",
            seed=SEEDS, beta=BETAS, clock=CLOCKS
        ),
        expand(
            "results/braga/{seed}/b{beta}_c{clock}/elbow_metrics.json",
            seed=SEEDS, beta=BETAS, clock=CLOCKS
        )
    output:
        "braga_precision.svg",
        "braga_recall.svg",
        "braga_f1.svg",
        "braga_precision_elbow.svg",
        "braga_recall_elbow.svg",
        "braga_f1_elbow.svg"
    shell:
        """
        python braga_plotting.py
        """
